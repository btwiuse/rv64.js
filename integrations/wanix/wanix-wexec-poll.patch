+func pollJSOutput(stdoutPath, stderrPath string, done *atomic.Int32) {
+	stdoutOffset, stderrOffset := 0, 0
+	for done.Load() == 0 {
+		pollJSFile(stdoutPath, os.Stdout, &stdoutOffset)
