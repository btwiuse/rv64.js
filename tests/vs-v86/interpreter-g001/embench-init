#!/bin/sh

# PID 1 for the sealed G001 Embench transfer population. Nothing in the
# transfer population executes until the host has booted the guest, verified
# its identity, and explicitly released one benchmark over ttyS0.

mount -t devtmpfs dev /dev 2>/dev/null || true
exec >/dev/ttyS0 2>&1 </dev/ttyS0
mount -t proc proc /proc 2>/dev/null || true
mount -t sysfs sys /sys 2>/dev/null || true
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

echo "G001_EMBENCH_GUEST linux=$(uname -r) alpine=$(cat /etc/alpine-release) arch=$(uname -m)"
echo G001_EMBENCH_READY
exec /bin/sh
