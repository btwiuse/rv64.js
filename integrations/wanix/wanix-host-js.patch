diff --git a/web/jsdriver.go b/web/jsdriver.go
index 46f5374..e3511ba 100644
--- a/web/jsdriver.go
+++ b/web/jsdriver.go
@@ -22,7 +22,23 @@ func (d *JSDriver) Check(t *wanix.Task) bool {
 }
 
 func (d *JSDriver) Start(t *wanix.Task) error {
-	data, err := fs.ReadFile(d.Root.NS(), t.Arg(0))
+	for _, entry := range t.Env() {
+		key, value, ok := strings.Cut(entry, "=")
+		if !ok {
+			continue
+		}
+		switch key {
+		case "WEXEC_STDOUT":
+			if err := t.SetFD(1, value); err != nil {
+				return err
+			}
+		case "WEXEC_STDERR":
+			if err := t.SetFD(2, value); err != nil {
+				return err
+			}
+		}
+	}
+	data, err := fs.ReadFile(t.NS(), t.Arg(0))
 	if err != nil {
 		return err
 	}
