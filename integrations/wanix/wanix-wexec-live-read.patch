+func readLiveFile(path string) ([]byte, error) {
+	f, err := os.Open(path)
+	if err != nil {
+		return nil, err
+	}
+	defer f.Close()
+	buf := make([]byte, 4096)
+	out := make([]byte, 0, 4096)
+	for {
+		n, readErr := f.Read(buf)
+		if n > 0 {
+			out = append(out, buf[:n]...)
+		}
+		if readErr == io.EOF {
+			return out, nil
+		}
+		if readErr != nil {
+			return nil, readErr
+		}
+		if n == 0 {
+			return out, nil
+		}
+	}
