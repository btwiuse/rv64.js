#!/bin/sh
set -eu
. /opt/holdout/expected.env

rm -f /tmp/holdout.aes
echo BENCH_START
i=0
while [ "$i" -lt 16 ]; do
    openssl enc -aes-256-ctr -nosalt \
        -K 00112233445566778899aabbccddeeff102132435465768798a9bacbdcedfe0f \
        -iv 0f0e0d0c0b0a09080706050403020100 \
        -in /opt/holdout/corpus.bin -out /tmp/holdout.aes
    i=$((i + 1))
done
echo BENCH_DONE
actual="$(sha256sum /tmp/holdout.aes | cut -d' ' -f1)"
[ "$actual" = "$AES_SHA256" ]
printf 'checksum=0x%s\n' "$(printf '%s' "$actual" | cut -c1-16)"
