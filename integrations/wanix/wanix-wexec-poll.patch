+func pollJSFile(path string, dst io.Writer, offset *int) {
+	data, err := os.ReadFile(path)
+	if err != nil {
+		if errors.Is(err, syscall.ENODATA) || errors.Is(err, syscall.EAGAIN) {
+			return
+		}
+		log.Fatal(err)
+	}
+	if len(data) > *offset {
+		dst.Write(data[*offset:])
+		*offset = len(data)
+	}
+}
