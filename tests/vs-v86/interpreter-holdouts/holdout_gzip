#!/bin/sh
set -eu
. /opt/holdout/expected.env

rm -f /tmp/holdout.gz /tmp/holdout.raw
echo BENCH_START
i=0
while [ "$i" -lt 4 ]; do
    gzip -n -c /opt/holdout/corpus.bin > /tmp/holdout.gz
    i=$((i + 1))
done
echo BENCH_DONE
gzip -dc /tmp/holdout.gz > /tmp/holdout.raw
actual="$(sha256sum /tmp/holdout.raw | cut -d' ' -f1)"
[ "$actual" = "$CORPUS_SHA256" ]
printf 'checksum=0x%s\n' "$(printf '%s' "$actual" | cut -c1-16)"
