{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rv64-release-assets",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-31",
  "vars": {
    "ALIAS_TTL_SECONDS": "60",
    "EDGE_ALIAS_TTL_SECONDS": "60",
    "GITHUB_REPOSITORY": "ibuildthecloud/rv64.js",
    "R2_PUBLIC_BASE_URL": "",
    "R2_REDIRECT_TTL_SECONDS": "3600",
  },
  "r2_buckets": [
    {
      "binding": "ASSETS",
      "bucket_name": "rv64-release-assets",
      "preview_bucket_name": "rv64-release-assets-dev",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "COORDINATOR",
        "class_name": "Coordinator",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Coordinator"],
    },
  ],
}
